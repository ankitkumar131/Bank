# ==========================================
# Git Ignore Configuration
# Full-Stack Banking Application
# (Next.js Frontend + Express/Node Backend)
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
/.pnp
.pnp.js

# ------------------------------------------
# Production & Build Outputs
# ------------------------------------------
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
# Ignore all environment files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Whitelist example environment templates
!.env.example
!.env.*.example

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------------------
# Logs & Debugging
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Database & ORM
# ------------------------------------------
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# ------------------------------------------
# Caches & Temporary Files
# ------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
tmp/
temp/
